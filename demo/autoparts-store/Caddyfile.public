
{$DEMO_DOMAIN:localhost} {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }
    log {
        output stdout
        format json
    }

    # Public Helperium surface for the storefront: static widget assets and
    # browser-originated named-chat requests only. Agent management is local
    # admin traffic and must not be made public by this reverse proxy.
    @assistant_embed path /embed/*
    handle @assistant_embed {
        reverse_proxy {$HELPERIUM_API_UPSTREAM:api:8081}
    }

    @assistant_chat {
        method POST
        path /api/chat /api/chat/*
    }
    handle @assistant_chat {
        reverse_proxy {$HELPERIUM_API_UPSTREAM:api:8081}
    }

    # embed.js fetches this read-only UI configuration at startup. Do not expose
    # any other /api/agents management route through the public storefront.
    @assistant_widget_config {
        method GET
        path_regexp agent_widget_config ^/api/agents/[A-Za-z0-9][A-Za-z0-9_-]{0,127}/widget-config$
    }
    handle @assistant_widget_config {
        reverse_proxy {$HELPERIUM_API_UPSTREAM:api:8081}
    }

    @assistant_private path /api/*
    handle @assistant_private {
        respond "not found" 404
    }

    # Django admin is local management tooling; the public storefront must not
    # expose it (there is also no seeded superuser, so fail closed entirely).
    @django_admin path /admin /admin/*
    handle @django_admin {
        respond "not found" 404
    }

    handle {
        reverse_proxy storefront:8000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }
}
