
{$DEMO_DOMAIN:localhost} {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # No includeSubDomains/preload: the demo domain may host unrelated
        # sibling services that are not ready for a blanket HTTPS commitment.
        Strict-Transport-Security "max-age=31536000"
        # Tailored to the storefront plus the embed widget: the widget injects
        # <style> into its Shadow DOM and plays blob: audio; the storefront
        # loads Google Fonts. There are no <img> tags, so images stay
        # same-origin. frame-ancestors is intentionally omitted pending a
        # deployment decision on portal embedding (see README).
        # connect-src 'self' assumes the widget talks to the API through this
        # same-origin reverse proxy (HELPERIUM_API_BASE defaults to empty). If
        # a deployer ever points HELPERIUM_API_BASE at an external origin, the
        # CSP here must add that origin to connect-src or widget requests will
        # be blocked regardless of CORS.
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; media-src 'self' blob:; base-uri 'self'; form-action 'self'"
    }
    log {
        output stdout
        format json
    }

    # Public Helperium surface for the storefront: static widget assets and
    # browser-originated named-chat requests only. Agent management is local
    # admin traffic and must not be made public by this reverse proxy.
    @assistant_embed path /embed/*
    handle @assistant_embed {
        reverse_proxy {$HELPERIUM_API_UPSTREAM:api:8081}
    }

    @assistant_chat {
        method POST
        path /api/chat /api/chat/*
    }
    handle @assistant_chat {
        reverse_proxy {$HELPERIUM_API_UPSTREAM:api:8081}
    }

    # embed.js fetches this read-only UI configuration at startup. Do not expose
    # any other /api/agents management route through the public storefront.
    @assistant_widget_config {
        method GET
        path_regexp agent_widget_config ^/api/agents/[A-Za-z0-9][A-Za-z0-9_-]{0,127}/widget-config$
    }
    handle @assistant_widget_config {
        reverse_proxy {$HELPERIUM_API_UPSTREAM:api:8081}
    }

    @assistant_private path /api/*
    handle @assistant_private {
        respond "not found" 404
    }

    # Django admin is local management tooling; the public storefront must not
    # expose it (there is also no seeded superuser, so fail closed entirely).
    @django_admin path /admin /admin/*
    handle @django_admin {
        respond "not found" 404
    }

    handle {
        reverse_proxy storefront:8000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }
}
