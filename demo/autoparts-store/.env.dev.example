# Copy to .env for the local Django storefront / Helperium demo only.
# This file belongs to demo/autoparts-store, not the root Helperium environment.
#
#   cp .env.dev.example .env
#   # generate the two passwords below, then:
#   docker-compose up -d
#   # or from the repository root:
#   ./infra/scripts/dev.sh start --with-autoparts

# Storefront's local writer account. This never becomes a Helperium tenant DSN.
STORE_DB_PASSWORD=replace-with-a-local-storefront-password

# Helperium's separate PostgreSQL login. The bootstrap grants it SELECT only.
# Generate with: openssl rand -hex 32
HELPERIUM_AUTOPARTS_RO_USER=helperium_autoparts_ro
HELPERIUM_AUTOPARTS_RO_PASSWORD=replace-with-a-local-readonly-password
