# Apply these values to the Helperium core environment that serves
# HELPERIUM_API_UPSTREAM. This file is not consumed by docker-compose.public.yml
# and must not be committed with real secrets.
#
# Replace demo.example.com and all placeholder secrets before deployment.

# The storefront is the only browser origin allowed to call api-service.
CORS_ALLOW_ORIGINS=https://demo.example.com

# api-service control-plane token. Keep it distinct from MCP credentials.
API_BEARER_TOKEN=replace-with-a-generated-api-control-plane-secret

# mcp-gateway is internal-only, but auth remains mandatory as defence in depth.
MCP_REQUIRE_AUTH=true
MCP_API_KEY=replace-with-a-generated-mcp-service-secret
MCP_CLIENT_API_KEY=replace-with-the-same-mcp-service-secret
# No browser-facing MCP ingress exists in the narrow demo.
MCP_ALLOWED_ORIGINS=

# Must be reconciled with API_BEARER_TOKEN before enabling admin-dashboard
# management calls. See the Stage 6 deployment checklist.
ADMIN_TOKEN=replace-with-an-admin-secret

# The autoparts public Compose bootstrap uses this exact value as
# HELPERIUM_DATA_ADMIN_TOKEN to register and rewrite the read-only tenant over
# the private Docker bridge. Keep it out of source control.
