    "substrate": "stub",
    "provider_concurrency": 256,
    "p50_ms": 1,
    "p95_ms": 5
  },
  "workload": [
    {
      "weight": 0.5,
      "name": "one_tool",
      "tools": ["db_get"],
      "history_turns": 0
    },
    {
      "weight": 0.5,
      "name": "search_get",
      "tools": ["db_search", "db_get"],
      "history_turns": 3
    }
  ],
  "budget_preset": "off"
