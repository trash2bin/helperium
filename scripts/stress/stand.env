# scripts/stress/stand.env — единственный источник env для нативного стенда.
#
# Стенд — это data-service + mcp-gateway + api-service + стаб LLM, поднятые
# нативно (не в Docker), чтобы CPU/профилировщик видели настоящий процесс
# api-service, а не контейнер. Значения — тестовые, из .env намеренно не
# берутся: compose-скрипт для E2E подменяет .env своими значениями, и мы не
# хотим, чтобы стенд зависел от порядка, в котором запускали E2E.

ADMIN_TOKEN=ci-admin-token
API_BEARER_TOKEN=ci-api-control-token
MCP_API_KEY=ci-mcp-token
MCP_CLIENT_API_KEY=ci-mcp-token
MCP_ALLOWED_ORIGINS=http://localhost:8080

# Лимиты стенда сняты (значения по умолчанию — 30/minute и 10 rps), иначе
# лестница измеряла бы slowapi и rate limiter, а не платформу. --budget в
# run-l1*.sh/run-l2*.sh повторяет эти значения, чтобы харнесс проверял, что
# лимит действительно снят, а не просто не известен харнессу.
MCP_RATE_LIMIT_RPS=1000
MCP_RATE_LIMIT_BURST=1000
ABUSE_IP_RPS=1000
ABUSE_IP_BURST=1000
# Квота ходов на сессию (серверный дефолт 50, anti_abuse.py). L2-стадия за 90 c
# при 40 rps и пуле в 64 сессии успевает сделать ~56 ходов на сессию и упирается
# в квоту: лестница читала это как 11% ошибок и объявляла fail на 40 rps, хотя
# платформа держала 237 мс. Это тот же ложный потолок §5, что и у IP-лимитов,
# поэтому квота снимается вместе с ними (харнесс ротирует сессии лишь по
# объявленному recycle_after_turns, а его раннер пока не исполняет).
ABUSE_MAX_USER_TURNS=1000000
CHAT_RATE_LIMIT=60000/minute

BACKLOG_MODE=off
GUARDRAIL_ENABLED=false
LOG_LEVEL=warning
HEALTH_CHECK_SKIP_LLM=true
MCP_DEV=false
MCP_REQUIRE_AUTH=true
AGENT_MAX_TURN_TOKENS=32768
# Число воркер-процессов uvicorn (Трек 3). 1 = исторический однопроцессный
# режим; >1 распараллеливает agent loop по ядрам. Откат — API_WORKERS=1.
API_WORKERS=${API_WORKERS:-1}
# Shared-хранилища для rate limit / abuse-бакетов (Трек 3). Пусто = in-memory
# (откат); redis://... = один бакет на все воркеры, суммарный лимит не растёт.
# RATE_LIMIT_STORAGE_URI=${RATE_LIMIT_STORAGE_URI:-}
# ABUSE_STORAGE_URI=${ABUSE_STORAGE_URI:-}
# Сессия/история ходов поверх Redis (убирает SQLite WAL из горячего пути —
# главный contention-пункт на Linux-стенде). Пусто = SQLite (откат);
# redis://... = Redis-бэкенд. Можно тот же инстанс, что ABUSE_STORAGE_URI.
SESSION_STORAGE_URI=${SESSION_STORAGE_URI:-}
# Транспорт LLM: direct (OpenAICompatibleProvider, httpx мимо litellm) или
# litellm. См. doc/agents/api-service-decomposition-plan.md §2.
LLM_PROVIDER_TRANSPORT=${LLM_PROVIDER_TRANSPORT:-litellm}
# Потолок раундов агента на ход. Стоит здесь, а не только в run-*.sh, потому
# что его читает api-service на старте: если харнесс и сервер считают разное,
# лестница упирается в терминатор, а не в ёмкость. Профили L2 планируют
# 2-3 раунда, 5 — запас; profile.py отвергает шаг, который сервер обрежет.
AGENT_MAX_ITERATIONS=5
# Сессии/история ходов в файл, а не в память: переживает рестарт стенда,
# иначе повтор knee после высокой стадии мерял бы пустую историю.
DEMO_SESSION_DB_PATH=$(pwd)/.data/sessions/demo_sessions.sqlite

# Стаб LLM. Дефолты здесь — нано-L2 профиль (chat-zero-latency-l2); они же
# сработают, если переменная уже задана в окружении (${VAR:-default}), поэтому
# run-l2-realistic.sh может переопределить их до вызова start-stub.sh.
STUB_P50_MS=${STUB_P50_MS:-1}
STUB_P95_MS=${STUB_P95_MS:-5}
# Параллелизм стаба = profile.llm.provider_concurrency (256 в обоих L2-профилях).
# Больше воркеров у стаба, чем заявлено в профиле, сделало бы очередь стаба
# невидимой для манифеста: подписи расходились бы с тем, что реально стоит.
STUB_CONCURRENCY=${STUB_CONCURRENCY:-256}
# Доставка тела ответа: 1 чанк = прежний Content-Length (нано-L2),
# >1 = chat-slow-l2 (реалистичный профиль). Пауза между чанками входит в
# service_ms стаба, чтобы §7 не приписал её платформе.
STUB_RESPONSE_CHUNKS=${STUB_RESPONSE_CHUNKS:-1}
STUB_CHUNK_DELAY_MS=${STUB_CHUNK_DELAY_MS:-0}

# Трейсинг выключен: стенд — измерительный инструмент, и OTEL-экспортёр,
# шлющий protobuf-батчи в отсутствующий коллектор (localhost:4318), меряет
# сам себя, а не платформу. py-spy на 40 rps показал self-time в urlopen
# (urllib3), putheader, getaddrinfo и _encode_span (protobuf) — это ретраи
# экспортёра и кодирование батчей, а не код api-service. Возвращает
# откат: OTEL_SDK_DISABLED= или OTEL_ENABLED=true.
OTEL_SDK_DISABLED=true
